# --- Datenbank ---
# Lokal: SQLite-Datei. Produktion: Postgres-URL (provider in prisma/schema.prisma umstellen)
DATABASE_URL="file:./dev.db"

# --- Sicherheit ---
# 32 Byte, base64. Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Mind. 32 Zeichen zufällig. Gleiches Kommando wie oben.
SESSION_SECRET=""

# --- Erster Inhaber-Login (wird von "npm run setup" angelegt) ---
OWNER_EMAIL="du@example.at"
OWNER_PASSWORD="bitte-aendern-min-12-zeichen"
OWNER_NAME="Inhaber"

# --- Externe Dienste (optional hier ODER verschlüsselt unter Einstellungen) ---
# Ohne Schlüssel läuft die App im Demo-Modus (Beispieldaten, keine Kosten).
APIFY_TOKEN=""
ANTHROPIC_API_KEY=""
# Modell für KI-Schritte. Standard: claude-opus-5-5. Günstiger: claude-sonnet-5-5 oder claude-haiku-5-5
CLAUDE_MODEL="claude-opus-5-5"

# --- Geschäftsparameter ---
USD_EUR_RATE="0.92"
LEAD_RETENTION_DAYS="180"
